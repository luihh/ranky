---
import '@fontsource-variable/inter';
import '@/styles/global.css';

import Navbar from '@/components/Navbar.astro';

const { title, favicon, navbar = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={favicon}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>

    <script src="../scripts/theme-loader.js"></script>
  </head>
  <body>
    {navbar ? <Navbar /> : ''}
    <slot />
  </body>
</html>
